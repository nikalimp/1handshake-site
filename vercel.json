{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/@:handle/llms.txt", "destination": "https://app.1handshake.com/@:handle/llms.txt" },
    { "source": "/@:handle", "destination": "https://app.1handshake.com/@:handle" },
    { "source": "/_next/image", "destination": "https://app.1handshake.com/_next/image" }
  ]
}
